{
    "name": "tyhpdef/spatie-flare-client-php-impl",
    "description": "Implementation package for tyhpdef/spatie-flare-client-php. Require tyhpdef/spatie-flare-client-php, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.11.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/spatie-backtrace": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/spatie-flare-client-php"
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/flare-client-php": "1.11.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev"
    }
}
